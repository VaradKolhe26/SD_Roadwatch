# ==============================================================================
# RoadWatch Environment Configuration Example
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# Server Port (defaults to 3000 if not specified)
PORT=3000

# Google Maps Platform Keys
# Used for Google Maps Embed, Geocoding, Places, and Routes API
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Google Gemini AI API Key
# Used for backend AI hazard scanning, volumetric depth calibration, and severity estimation
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Database Configuration (Optional)
# If provided, all tickets, votes, and SLA telemetry persist directly to Supabase.
# If omitted, the server operates in robust in-memory mode automatically.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# App Base URL (optional, used for OAuth callbacks and share links)
APP_URL="http://localhost:3000"
